<script src="https://app.poweredbyhue.app/js/integration.js" defer></script>
<script>
document.addEventListener('hue-add-to-cart', async (event) => {
  const { variantId } = event.detail;

  try {
    // Додаємо товар у кошик
    const res = await fetch(`${window.Shopify.routes.root}cart/add.js`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 }),
    });

    const addedItem = await res.json();

    // Тригеримо офіційну подію Shopify для оновлення UI
    document.documentElement.dispatchEvent(new CustomEvent('cart:updated', {
      bubbles: true,
      detail: { cartData: addedItem }
    }));

    // Викликаємо офіційну подію для перезавантаження Drawer'а
    if (window.CartDrawer) {
      window.CartDrawer.renderContents(); // новий метод у Horizon/Dawn
    } else {
      // Альтернатива — відкрити Drawer вручну
      const cartToggle = document.querySelector('cart-drawer, cart-drawer-component, cart-drawer-toggle');
      cartToggle?.open?.();
    }

  } catch (error) {
    console.error('Error adding to cart:', error);
  }
});
</script>
