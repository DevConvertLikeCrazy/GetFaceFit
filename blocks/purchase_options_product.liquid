{%- style -%}
  .purchase-type__title{
    color: {{ block.settings.title_cl }};
    font-size: {{ block.settings.title_fs }}px;
  }

  .purchase-type__tab span{
    color: {{ block.settings.tabs_cl }};
    font-size: {{ block.settings.tabs_fs }}px;
  }

  .purchase-type__tab.active span{
    color: {{ block.settings.tabs_cl_ac }};
  }

  .purchase-type__tab span strong{
    color: {{ block.settings.badge_cl }};
    background: {{ block.settings.badge_bg }};
    font-size: {{ block.settings.badge_fs }}px;
  }

  .purchase-schedule__title{
    color: {{ block.settings.content_cl }};
    font-size: {{ block.settings.content_fs }}px;
  }

  .tier-title{
    color: {{ block.settings.tab_title_cl }};
    font-size: {{ block.settings.tab_title_fs }}px;
  }

  .tier-text{
    color: {{ block.settings.tab_text_cl }};
    font-size: {{ block.settings.tab_text_fs }}px;
    font-weight: {{ block.settings.tab_text_fw }}; 
  }

  .tier-info{
    color: {{ block.settings.tab_info_cl }};
    font-size: {{ block.settings.tab_info_fs }}px;
    font-weight: {{ block.settings.tab_info_fw }}; 
  }

  .tier-text em{
    color: {{ block.settings.tab_text_cl }};
    font-size: {{ block.settings.tab_text_small_fs }}px;
  }

  .tier-badge{
    color: {{ block.settings.tab_badge_cl }};
    background: {{ block.settings.tab_badge_bg }};
    font-size: {{ block.settings.tab_badge_fs }}px;
  }

  .tier-price{
    color: {{ block.settings.tab_price_cl }};
    font-size: {{ block.settings.tab_price_fs }}px;
  }

  .tier-compare{
    color: {{ block.settings.tab_price_compare_cl }};
    font-size: {{ block.settings.tab_price_compare_fs }}px;
  }

  .add-to-cart-text__content [ref="priceContainer"]{
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media (max-width: 990px){
    .purchase-type__title{
      font-size: {{ block.settings.title_fs_mob }}px;
    }

    .purchase-type__tab span{
      font-size: {{ block.settings.tabs_fs_mob }}px;
    }

    .purchase-type__tab span strong{
      font-size: {{ block.settings.badge_fs_mob }}px;
    }

    .purchase-schedule__title{
      font-size: {{ block.settings.content_fs_mob }}px;
    }

    .tier-title{
      font-size: {{ block.settings.tab_title_fs_mob }}px;
    }

    .tier-text{
      font-size: {{ block.settings.tab_text_fs_mob }}px;
      font-weight: {{ block.settings.tab_text_fw_mob }}; 
    }

    .tier-info{
      font-size: {{ block.settings.tab_info_fs_mob }}px;
    }

    .tier-text em{
      font-size: {{ block.settings.tab_text_small_fs_mob }}px;
    }

    .tier-badge{
      font-size: {{ block.settings.tab_badge_fs_mob }}px;
    }

    .tier-price{
      font-size: {{ block.settings.tab_price_fs_mob }}px;
    }

    .tier-compare{
      font-size: {{ block.settings.tab_price_compare_fs_mob }}px;
    }
  }
{%- endstyle -%}


<div class="purchase-type" {% if block.settings.show_type == false %} style="display: none"{% endif %}>
  <h4 class="purchase-type__title">{{ block.settings.block_title }}</h4>

  <div class="purchase-type__tabs">
    <label class="purchase-type__tab active" data-purchase="subscription">
      <input type="radio" name="purchase_type" value="subscription" checked>
      <span>{{ block.settings.subs_title }}</span>
    </label>

    <label class="purchase-type__tab" data-purchase="onetime">
      <input type="radio" name="purchase_type" value="onetime">
      <span>{{ block.settings.one_title }}</span>
    </label>
  </div>
</div>

<!-- Subscription Options -->
<div class="purchase-schedule subscription-schedule active">
  <h4 class="purchase-schedule__title">{{ block.settings.subscribe_title }}</h4>
  <ul class="subscription-options__list list-unstyled">

    {%- assign months_words = 'month,months' | split: ',' -%}

    {%- assign one_time_keywords = 'one-time,1 time,buy once,single' | split: ',' -%}


    {%- assign otp_variant = nil -%}


    {%- for variant in product.variants -%}
      {%- assign v_title = variant.title | downcase -%}

      {%- comment -%} Detect OTP variant once and store it {%- endcomment -%}
      {%- if otp_variant == nil -%}
        {%- for word in one_time_keywords -%}
          {%- if v_title contains word -%}
            {%- assign otp_variant = variant -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} OTP card under subscription cards {%- endcomment -%}
    {%- if otp_variant -%}
      <li class="subscription-tier subscription-tier--otp"{% if block.settings.show_type == true %} style="display: none"{% endif %}>
        <label class="tier-label">
          <div class="tier-content-wrapper">
            <input
              type="radio"
              class="tier-input"
              name="subscription_tier"
              value=""
              data-selling-plan=""
              data-variant-id="{{ otp_variant.id }}"
              data-quantity="1"
              data-price="{{ otp_variant.price }}"
              data-base-price="{{ otp_variant.price }}"
              data-total-discounted="{{ otp_variant.price }}"
              data-total-base="{{ otp_variant.price }}"
            >

            <div class="tier-left">

              {%- assign no_title = false -%}

              {%- for item in product.metafields.custom.purchase_text.value -%}
                {%- if item.title_id == otp_variant.title -%}
                  {%- if item.title != blank -%}
                    <span class="tier-title">{{ item.title | metafield_tag }}</span>
                    {%- assign no_title = true -%}
                  {%- else -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              
              {%- if no_title == false -%}
                <span class="tier-title">{{ otp_variant.title }}</span>
              {%- endif -%}

            </div>
          </div>
         

          <div class="tier-content">
            <div class="tier-right">
              {%- for item in product.metafields.custom.purchase_text.value -%}
                {%- if item.title_id == otp_variant.title -%}
                  <div class="tier-text">{{ item.text | metafield_tag }}</div>
                {%- endif -%}
              {%- endfor -%}
              <div class="tier-prices">
                <span class="tier-price">{{ otp_variant.price | money }}</span>
              </div>
            </div>
          </div>
        </label>
       
      </li>
    {%- endif -%}

    {%- for variant in product.variants -%}
      {% assign is_last = forloop.last %}
      {%- assign v_title = variant.title | downcase -%}

      {%- for word in one_time_keywords -%}
        {%- if v_title contains word -%}
          {%- assign fix_price = variant.price -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- assign is_sub_variant = false -%}
      {%- for w in months_words -%}
        {%- if v_title contains w -%}
          {%- assign is_sub_variant = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if is_sub_variant -%}
        {%- assign digits = '' -%}
        {%- for i in (0..v_title.size) -%}
          {%- assign ch = v_title | slice: i, 1 -%}
          {%- if ch >= '0' and ch <= '9' -%}
            {%- assign digits = digits | append: ch -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign months_num = digits | plus: 0 -%}
        {%- if months_num == 0 -%}{%- assign months_num = 1 -%}{%- endif -%}

        {%- assign matched_plan = nil -%}
        {%- for spg in product.selling_plan_groups -%}
          {%- for sp in spg.selling_plans -%}
            {%- assign plan_name = sp.name | downcase -%}
            {%- if plan_name contains months_num -%}
              {%- assign matched_plan = sp -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if matched_plan -%}{%- break -%}{%- endif -%}
        {%- endfor -%}

        {%- assign base_price_total = variant.price -%}
        {%- assign unit_base_price = base_price_total | divided_by: months_num -%}

        {%- assign discount_percentage = 0 -%}
        {%- if matched_plan and matched_plan.price_adjustments.size > 0 -%}
          {%- for adj in matched_plan.price_adjustments -%}
            {%- if adj.value_type == 'percentage' -%}
              {%- assign discount_percentage = adj.value -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- assign minus_percent = 100 | minus: discount_percentage -%}
        {%- assign unit_discounted_price = unit_base_price | times: minus_percent | divided_by: 100 -%}
        {%- assign savings_per_unit = unit_base_price | minus: unit_discounted_price | times: months_num -%}

        <li class="subscription-tier">
          <label class="tier-label">
           
            <div class="tier-content">
              <div class="tier-content-wrapper">
                <input
                  type="radio"
                  class="tier-input"
                  name="subscription_tier"
                  value="{{ matched_plan.id | default: '' }}"
                  data-selling-plan="{{ matched_plan.id | default: '' }}"
                  data-variant-id="{{ variant.id }}"
                  data-quantity="{{ months_num }}"
                  data-price="{{ unit_discounted_price }}"
                  data-base-price="{{ unit_base_price }}"
                  data-total-discounted="{{ unit_discounted_price | times: months_num }}"
                  data-total-base="{{ unit_base_price | times: months_num }}"
                  {% if is_last %}checked{% endif %}
                >

                {% if months_num > 1 %}
                  {%- assign title = "Every " | append: months_num | append: ' months' -%}
                {%- else -%}
                  {%- assign title = "Every " | append: months_num | append: ' month' -%}
                {% endif %}
                {%- assign no_title = false -%}

                {%- for item in product.metafields.custom.purchase_text.value -%}
                  {%- if item.title_id == title -%}
                    {%- if item.title != blank -%}
                      <span class="tier-title">{{ item.title | metafield_tag }}</span>
                      {%- assign no_title = true -%}
                    {%- else -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                
                {%- if no_title == false -%}
                  <span class="tier-title">{{ title }}</span>
                {%- endif -%}

              </div>
               
              <div class="tier-left">
                {% if savings_per_unit > 0 %}
                  <span class="tier-badge">{{ block.settings.save_text }} {{ savings_per_unit | money }}</span>
                {% endif %}
              </div>
            
            </div>
            <div class="tier-right">
              <span class="tier-price">
                {% if savings_per_unit > 0 %}
                  <span class="tier-compare mobile">{{ fix_price | money }}</span>
                {% endif %}

                {{ unit_discounted_price | money }} / month
                </span>

              <div class="tier-info-compare">
                {%- for item in product.metafields.custom.purchase_text.value -%}
                  {%- if item.title_id == title -%}
                    {%- if item.info != blank -%}
                      <span class="tier-info">{{ item.info | metafield_tag }}</span>
                    {%- else -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                {% if savings_per_unit > 0 %}
                  <span class="tier-compare">{{ fix_price | money }}</span>
                {% endif %}
              </div>
             
            </div>
          </label>

          {%- for item in product.metafields.custom.purchase_text.value -%}
            {%- if item.title_id == title -%}
              <div class="tier-text">{{ item.text | metafield_tag }}</div>
            {%- endif -%}
          {%- endfor -%}
        </li>

      {%- endif -%}
    {%- endfor -%}

  </ul>
</div>

<!-- One-time Purchase Options -->
<div class="purchase-schedule onetime-schedule">
  <h4 class="purchase-schedule__title">{{ block.settings.choose_quantity }}</h4>
  <ul class="onetime-options__list list-unstyled">

  {%- assign one_time_variant = nil -%}
  {%- assign one_time_keywords = 'one-time,1 time,buy once,single' | split: ',' -%}

  {%- for variant in product.variants -%}
    {%- assign v_title = variant.title | downcase -%}
    {%- for word in one_time_keywords -%}
      {%- if v_title contains word -%}
        {%- assign one_time_variant = variant -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if one_time_variant -%}{%- break -%}{%- endif -%}
  {%- endfor -%}

  {%- if one_time_variant -%}
    {%- for qty in product.metafields.custom.product_quantity_blocks.value -%}
      {%- assign base_price = one_time_variant.price -%}
      {%- assign total_price = base_price | times: qty.quantiy -%}
      {%- assign discount_percent = qty.discount_percentage | default: 0 -%}
      {%- assign discount_multiplier = 100 | minus: discount_percent -%}
      {%- assign discounted_price = total_price | times: discount_multiplier | divided_by: 100 -%}
      {%- assign savings = total_price | minus: discounted_price -%}

      <li class="onetime-tier">
        <label class="tier-label">
          <input
            type="radio"
            class="tier-input"
            name="onetime_tier"
            data-selling-plan=""
            data-variant-id="{{ one_time_variant.id }}"
            data-quantity="{{ qty.quantiy }}"
            data-price="{{ discounted_price }}"
            data-base-price="{{ total_price }}"
            {% if forloop.first %}checked{% endif %}
          >

          <div class="tier-content">
            <div class="tier-left">
              <span class="tier-title">{{ qty.title | metafield_tag }}</span>
              {% if savings > 0 %}
                <span class="tier-badge">{{ block.settings.save_text }} {{ savings | money }}</span>
              {% endif %}
            </div>

            <div class="tier-right">
              <div class="tier-prices">
                {% if savings > 0 %}
                  <span class="tier-badge mobile">{{ block.settings.save_text }} {{ savings | money }}</span>
                {% endif %}
                <span class="tier-price">{{ discounted_price | money }}</span>
                {% if savings > 0 %}
                  <span class="tier-compare">{{ total_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        </label>
      </li>
    {%- endfor -%}
  {%- else -%}
    <li><p>No one-time variant found (expected name includes “1 time”, “buy once”, etc.)</p></li>
  {%- endif -%}

</ul>
</div>


<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector('.shopify-product-form');
    if (!form) return;

    // --- Guarantee hidden inputs exist before anything happens ---
    function ensureHiddenInput(name) {
      let el = form.querySelector(`input[name="${name}"]`);
      if (!el) {
        el = document.createElement('input');
        el.type = 'hidden';
        el.name = name;
        form.appendChild(el);
      }
      return el;
    }

    const sellingPlanInput = ensureHiddenInput('selling_plan');
    const variantInput = form.querySelector('input[name="id"]');
    const qtyInput = ensureHiddenInput('quantity');

    // --- UI elements ---
    const tabs = document.querySelectorAll('.purchase-type__tab');
    const subBlock = document.querySelector('.subscription-schedule');
    const oneBlock = document.querySelector('.onetime-schedule');
    const subOptions = document.querySelectorAll('.subscription-tier input');
    const oneOptions = document.querySelectorAll('.onetime-tier input');

    // --- Price elements ---
    const priceContainer = document.querySelector('[ref="priceContainer"]');
    const priceEl = priceContainer?.querySelector('.price');
    const compareEl = priceContainer?.querySelector('.compare-at-price');

    // --- helpers ---
    const highlightSelection = (groupSelector, input) => {
      document.querySelectorAll(groupSelector).forEach(li => li.classList.remove('is-selected'));
      const li = input.closest('li');
      if (li) li.classList.add('is-selected');
    };

    // Utility: format to Shopify money
    // --- helpers for money formatting (supports prefix/suffix symbols) ---
const escapeRegExp = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

const getMoneyFormatFromExample = (exampleText) => {
  const t = (exampleText || '').replace(/\u00A0/g, ' ').trim();

  // currency symbol / code (anything except digits and common separators)
  const symbol = t.replace(/[\d\s.,'’٬٫-]/g, '').trim();

  const symbolIsPrefix = !!symbol && t.startsWith(symbol);

  // detect whether there is a space between symbol and number in the example
  let space = '';
  if (symbol) {
    if (symbolIsPrefix) space = t.startsWith(symbol + ' ') ? ' ' : '';
    else space = t.endsWith(' ' + symbol) ? ' ' : '';
  }

  // remove symbol occurrences to analyze numeric part
  const withoutSymbol = symbol ? t.replace(new RegExp(escapeRegExp(symbol), 'g'), '').trim() : t;

  // keep only digits + separators
  const numeric = withoutSymbol.replace(/[^\d.,'’٬٫\s-]/g, '').trim();

  // decimal separator: pick the LAST of (٫ . ,) if it looks like decimals (1-3 digits after)
  const lastComma = numeric.lastIndexOf(',');
  const lastDot = numeric.lastIndexOf('.');
  const lastArabicDec = numeric.lastIndexOf('٫');

  let decSep = '';
  let decPos = -1;

  const maxPos = Math.max(lastComma, lastDot, lastArabicDec);
  if (maxPos !== -1) {
    if (maxPos === lastArabicDec) decSep = '٫';
    else if (maxPos === lastDot) decSep = '.';
    else decSep = ',';

    decPos = maxPos;

    const afterDigits = numeric.slice(decPos + 1).replace(/\D/g, '');
    // if it doesn't look like a decimal part, treat as "no decimals"
    if (afterDigits.length === 0 || afterDigits.length > 3) {
      decSep = '';
      decPos = -1;
    }
  }

  const decimals = decSep ? numeric.slice(decPos + 1).replace(/\D/g, '').length : 0;

  // thousands separator: any separator found in integer part (excluding decSep)
  const intSample = decSep ? numeric.slice(0, decPos) : numeric;
  const thouSep =
    [',', '.', '٬', ' ', "'", '’'].find((sep) => sep !== decSep && intSample.includes(sep)) || '';

  return {
    symbol,
    symbolIsPrefix,
    space,
    decimals,
    decSep: decSep || '.', // fallback (rarely used if decimals=0)
    thouSep,
  };
};

// Utility: format cents to match current storefront currency formatting
const formatMoney = (cents) => {
  if (!priceEl) return String(cents);

  const fmt = getMoneyFormatFromExample(priceEl.textContent);

  const n = Number(cents) || 0;
  const sign = n < 0 ? '-' : '';
  const abs = Math.abs(n);

  const fixed = (abs / 100).toFixed(fmt.decimals);
  let [intStr, fracStr = ''] = fixed.split('.');

  if (fmt.thouSep) {
    intStr = intStr.replace(/\B(?=(\d{3})+(?!\d))/g, fmt.thouSep);
  }

  let num = sign + intStr;
  if (fmt.decimals > 0) num += fmt.decSep + fracStr;

  if (!fmt.symbol) return num;

  return fmt.symbolIsPrefix
    ? `${fmt.symbol}${fmt.space}${num}`
    : `${num}${fmt.space}${fmt.symbol}`;
};

    // Update price in the UI
    const updatePriceDisplay = (input) => {
    if (!input || !priceEl) return;

      const priceCents = parseFloat(input.dataset.price || 0);
      const baseCents = parseFloat(input.dataset.basePrice || 0);

      const totalDiscounted = parseFloat(input.dataset.totalDiscounted || priceCents);
      const totalBase = parseFloat(input.dataset.totalBase || baseCents);

      const compareVisible = totalBase > totalDiscounted;

      priceEl.textContent = formatMoney(priceCents);
      if (compareEl) {
        compareEl.textContent = formatMoney(baseCents);
        compareEl.style.display = compareVisible ? 'inline' : 'none';
      }

      const addToCartPrice = document.querySelector('.add-to-cart-text__content .price');
      const addToCartCompare = document.querySelector('.add-to-cart-text__content .compare-at-price');

      if (addToCartPrice) addToCartPrice.textContent = formatMoney(totalDiscounted);
      if (addToCartCompare) {
        addToCartCompare.textContent = formatMoney(totalBase);
        addToCartCompare.style.display = compareVisible ? 'inline' : 'none';
      }
    };

    const applySubscription = (input) => {
      if (!input) return;
      sellingPlanInput.value = input.dataset.sellingPlan || '';
      variantInput.value = input.dataset.variantId || variantInput.value;
      
      qtyInput.value = 1;
      
      highlightSelection('.subscription-tier', input);
      updatePriceDisplay(input);
    };

    const applyOnetime = (input) => {
      if (!input) return;
      sellingPlanInput.value = ''; // no selling plan for one-time
      variantInput.value = input.dataset.variantId || variantInput.value;
      qtyInput.value = input.dataset.quantity || 1;
      highlightSelection('.onetime-tier', input);
      updatePriceDisplay(input);
    };

    const setActiveTab = (type) => {
      tabs.forEach(t => t.classList.toggle('active', t.dataset.purchase === type));
      if (type === 'subscription') {
        subBlock.classList.add('active');
        oneBlock.classList.remove('active');
        const first = subOptions[0];
        if (first && !Array.from(subOptions).some(i => i.checked)) {
          first.checked = true;
          applySubscription(first);
        } else {
          const current = Array.from(subOptions).find(i => i.checked);
          if (current) applySubscription(current);
        }
      } else {
        subBlock.classList.remove('active');
        oneBlock.classList.add('active');
        const first = oneOptions[0];
        if (first && !Array.from(oneOptions).some(i => i.checked)) {
          first.checked = true;
          applyOnetime(first);
        } else {
          const current = Array.from(oneOptions).find(i => i.checked);
          if (current) applyOnetime(current);
        }
      }
    };

    // --- tab click handlers ---
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        setActiveTab(tab.dataset.purchase);
      });
    });

    // --- selection change handlers ---
    subOptions.forEach(inp => inp.addEventListener('change', () => applySubscription(inp)));
    oneOptions.forEach(inp => inp.addEventListener('change', () => applyOnetime(inp)));

    // --- initial setup ---
    const activeTab = Array.from(tabs).find(t => t.classList.contains('active'));
    setActiveTab(activeTab ? activeTab.dataset.purchase : 'subscription');
  });
</script>

{% schema %}
{
  "name": "Purchase Option",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_type",
      "label": "Show purchase type",
      "default": false
    },
    {
      "type": "text",
      "id": "block_title",
      "label": "Block title",
      "default": "Purchase Type"
    },
   
    {
      "type": "color",
      "id": "title_cl",
      "label": "Block title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_fs",
      "min": 8,
      "max": 44,
      "step": 1,
      "unit": "px",
      "label": "Title font-size",
      "default": 22
    },
    {
      "type": "range",
      "id": "title_fs_mob",
      "min": 8,
      "max": 44,
      "step": 1,
      "unit": "px",
      "label": "Title font-size mobile",
      "default": 20
    },
    {
      "type": "richtext",
      "id": "subs_title",
      "label": "Subscribe tab title",
      "default": "<p>Subscribe & <strong>Save up to 20% off</strong></p>"
    },
    {
      "type": "richtext",
      "id": "one_title",
      "label": "Buy once tab title",
      "default": "<p>Buy Once</p>"
    },

    {
      "type": "color",
      "id": "tabs_cl",
      "label": "Tabs color",
      "default": "#00000099"
    },
    {
      "type": "color",
      "id": "tabs_cl_ac",
      "label": "Tabs color active",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "tabs_fs",
