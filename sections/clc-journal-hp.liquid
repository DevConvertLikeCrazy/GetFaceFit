{{ 'article-section.css' | asset_url | stylesheet_tag }}
{{ 'article-card.css' | asset_url | stylesheet_tag }}

{%- style -%}

    .{{ section.id }}.clc-journal-hp{
        padding-top: {{ section.settings.padding_top }}px; 
        padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .{{ section.id }} .clc-journal-hp__header--title{
        color: {{ section.settings.title_cl }};
        font-size: {{ section.settings.title_fs }}px;
    }

    .{{ section.id }} .clc-journal-hp__link{
        font-size: {{ section.settings.btn_fs }}px;
        color: {{ section.settings.btn_cl }};
        {%- if section.settings.underline == true -%}
            text-decoration: underline;
        {%- endif -%}
    }

    @media (max-width: 990px){
        .{{ section.id }} .clc-journal-hp__header--title{
            font-size: {{ section.settings.title_fs_mob }}px;
        }

        .{{ section.id }} .clc-journal-hp__link{
            font-size: {{ section.settings.btn_fs_mob }}px;
        }

        .{{ section.id }} .clc-journal-hp{
            padding-top: {{ section.settings.padding_top_mob }}px; 
            padding-bottom: {{ section.settings.padding_bottom_mob }}px;
        }
    }
{%- endstyle -%}

<section class="clc-journal-hp container {{ section.id }}">
  <div class="clc-journal-hp__inner page-width">
    
    {% assign blog = blogs[section.settings.blog] %}
    {% if blog %}
      
      {% if section.settings.heading != blank %}
        <div class="clc-journal-hp__header" style="text-align: {{ section.settings.text_alignment }};">
          <div class="clc-journal-hp__header--title">{{ section.settings.heading }}</div>
        </div>
      {% endif %}

      <!-- 🟩 Tabs -->
      <div class="clc-journal-hp__tabs">
        <button class="clc-journal-hp__tab active" data-tag="all">All Articles</button>
        {% assign all_tags = '' %}
        {% for article in blog.articles %}
          {% for tag in article.tags %}
            {% unless all_tags contains tag %}
              {% assign all_tags = all_tags | append: tag | append: ',' %}
            {% endunless %}
          {% endfor %}
        {% endfor %}
        {% assign unique_tags = all_tags | split: ',' | uniq %}
        {% for tag in unique_tags %}
          {% unless tag == blank %}
            <button class="clc-journal-hp__tab" data-tag="{{ tag | handle }}">{{ tag }}</button>
          {% endunless %}
        {% endfor %}
      </div>

      <!-- 🟩 Articles wrapper -->
      <div class="clc-journal-hp__articles">
        <div class="clc-journal-hp__articles-group" data-tag="all"></div>
        {% for tag in unique_tags %}
          {% unless tag == blank %}
            <div class="clc-journal-hp__articles-group hidden" data-tag="{{ tag | handle }}"></div>
          {% endunless %}
        {% endfor %}
      </div>

      <!-- 🟩 Hidden storage for all blog articles -->
      <div class="clc-journal-hp__all-articles-storage" style="display:none;">
        {% for article in blog.articles %}
            {% render 'article-card', article: article, blog_title: blog.title %}
        {% endfor %}
      </div>

      <!-- 🟩 CTA -->
      {% if section.settings.cta_label != blank %}
        <div class="clc-journal-hp__cta" style="text-align: {{ section.settings.btn_alignment }};">
          <a href="{{ section.settings.cta_url }}" class="clc-journal-hp__link underline-link">
            {{ section.settings.cta_label }}
          </a>
        </div>
      {% endif %}

    {% else %}
      <p>Please select a blog in section settings.</p>
    {% endif %}
  </div>

  <!-- 🟩 JS logic -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.clc-journal-hp__tab');
      const groups = document.querySelectorAll('.clc-journal-hp__articles-group');
      const allArticles = Array.from(document.querySelectorAll('.clc-journal-hp__all-articles-storage .article-card'));
      const allContainer = document.querySelector('.clc-journal-hp__articles-group[data-tag="all"]');
    
      // 🔹 1. Сортуємо всі статті за датою (від новіших)
      allArticles.sort((a, b) => b.dataset.date - a.dataset.date);
    
      // 🔹 2. Показуємо 3 останні у вкладці "All Articles"
      allArticles.slice(0, 3).forEach(article => {
        allContainer.appendChild(article.cloneNode(true));
      });
    
      // 🔹 3. Визначаємо унікальні теги (чисті, без пробілів)
      const allTags = [...new Set(allArticles.flatMap(a => {
        return a.dataset.tags
          .split(',')
          .map(tag => tag.trim())
          .filter(Boolean);
      }))];
    
      // 🔹 4. Для кожного тегу створюємо статті у відповідний контейнер
      allTags.forEach(tag => {
        const tagHandle = tag
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
    
        const container = document.querySelector(`.clc-journal-hp__articles-group[data-tag="${tagHandle}"]`);
        if (!container) return;
    
        const taggedArticles = allArticles
          .filter(a => {
            const tags = a.dataset.tags.toLowerCase().split(',');
            return tags.some(t => t.trim() === tag.toLowerCase());
          })
          .sort((a, b) => b.dataset.date - a.dataset.date);
    
        taggedArticles.slice(0, 3).forEach(article => {
          container.appendChild(article.cloneNode(true));
        });
      });
    
      // 🔹 5. Перемикаємо вкладки
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          const targetTag = tab.dataset.tag;
          groups.forEach(group => {
            group.classList.toggle('hidden', group.dataset.tag !== targetTag);
          });
        });
      });
    });
    </script>
    
</section>
