<style>

    .article-section,
    .article-section__container--block{
        max-width: {{ section.settings.max_width }}px;
        padding: 64px 20px;
        margin: 0 auto;
    }

    .article-section h1{
        color: {{ section.settings.h1_cl }};
        font-size: {{ section.settings.h1_fs }}px;
    }

    .article-section h2{
        color: {{ section.settings.h2_cl }};
        font-size: {{ section.settings.h2_fs }}px;
    }

    .article-section h3{
        color: {{ section.settings.h3_cl }};
        font-size: {{ section.settings.h3_fs }}px;
    }

    .article-section h4{
        color: {{ section.settings.h4_cl }};
        font-size: {{ section.settings.h4_fs }}px;
    }

    .article-section h5{
        color: {{ section.settings.h5_cl }};
        font-size: {{ section.settings.h5_fs }}px;
    }

    .article-section h6{
        color: {{ section.settings.h6_cl }};
        font-size: {{ section.settings.h6_fs }}px;
    }

    .article-section p{
        color: {{ section.settings.p_cl }};
        font-size: {{ section.settings.p_fs }}px;
    }

    .article-section__container{
        background: {{ section.settings.bg }};
    }

    @media (max-width: 990px) {
        .article-section h1{
            font-size: {{ section.settings.h1_fs_mob }}px;
        }

        .article-section h2{
            font-size: {{ section.settings.h2_fs_mob }}px;
        }

        .article-section h3{
            font-size: {{ section.settings.h3_fs_mob }}px;
        }

        .article-section h4{
            font-size: {{ section.settings.h4_fs_mob }}px;
        }

        .article-section h5{
            font-size: {{ section.settings.h5_fs_mob }}px;
        }

        .article-section h6{
            font-size: {{ section.settings.h6_fs_mob }}px;
        }

        .article-section p{
            font-size: {{ section.settings.p_fs_mob }}px;
        }

        .article-section,
        .article-section__container--block{
            padding: 32px 20px;
        }
    }
</style>

<article class="article-section">
    <div class="article-section__wrapper">
        {{ article.content }}
        <div></div>
    </div>
</article>


