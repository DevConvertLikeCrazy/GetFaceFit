{{ 'header-custom.css' | asset_url | stylesheet_tag }}

{%- style -%}
    :root{
        --logo-width: {{ section.settings.logo_width }}
    }

    .header-custom__container{
        background: {{ section.settings.bg }};
        padding-top: {{ section.settings.pt }}px;
        padding-bottom: {{ section.settings.pb }}px;
    }

    .header-custom__menus--link{
        font-size: {{ block.settings.mob_mainlink_fs }}px;
    }

    .header-custom__logo img{
        width: {{ section.settings.logo_width }}px;
        height: {{ section.settings.logo_height }}px;
    }

    .header-custom__menus--item{
        padding-bottom: {{ section.settings.pb }}px;
        margin-bottom: -{{ section.settings.pb }}px;
    }

    @media (max-width: 990px){
        .header-custom__container{
            padding-top: {{ section.settings.pt_mob }}px;
            padding-bottom: {{ section.settings.pb_mob }}px;
        }

        .header-custom__logo img{
            width: {{ section.settings.logo_width_mob }}px;
            height: {{ section.settings.logo_height_mob }}px;
        }
    }

    {%- if section.settings.sticky == true -%}
        #header-group{
            position: sticky;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 999;
        }
    {%- endif -%}
{%- endstyle -%}

<script type="module" src="{{ 'cart-icon.js' | asset_url }}" fetchpriority="low"></script>

<header class="header-custom__container">
    <div class="header-custom__wrapper container">
        <div class="header__humburger">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 17.2705V16.2705H20V17.2705H4ZM4 12.5005V11.5005H20V12.5005H4ZM4 7.73047V6.73047H20V7.73047H4Z" fill="black"/>
            </svg>
        </div>
        <div class="header-custom__menus">
            {%- for item in section.settings.menu.links -%}
                {%- assign show_megamenu = false -%}

                {%- for block in section.blocks -%}
                    {%- if block.type == 'megamenu' -%}
                        {%- assign link_title = item.title | remove: ' ' | downcase -%}
                        {%- assign block_id = block.settings.id | remove: ' ' | downcase -%}

                        {%- if block_id == link_title -%}
                            {%- assign show_megamenu = true -%}
                        {%- endif -%}
                    {%- endif -%}
                {%- endfor -%}

                <div class="header-custom__menus--item">
                    <a class="header-custom__menus--link" href="{{ item.url }}">
                        {{ item.title }}
                        {%- if show_megamenu == true -%}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M11.9998 15.3102L17.7808 9.53075L16.7203 8.46875L11.9998 13.1893L7.28075 8.46875L6.21875 9.53075L11.9998 15.3102Z" fill="black"/>
                            </svg>
                        {%- endif -%}
                    </a>

                    {%- for block in section.blocks -%}
                        {%- if block.type == 'megamenu' -%}
                            {%- assign link_title = item.title | remove: ' ' | downcase -%}
                            {%- assign block_id = block.settings.id | remove: ' ' | downcase -%}
    
                            {%- if block_id == link_title -%}
                                {%- render 'megamenu', block: block -%}
                            {%- endif -%}
                        {%- endif -%}
                    {%- endfor -%}

                </div>
            {%- endfor -%}
        </div>
        <a href="/" class="header-custom__logo">
            <img 
                loading="lazy"
                width="{{ section.settings.logo_width }}" 
                height="{{ section.settings.logo_height }}" 
                src="{{ section.settings.logo | img_url: 'master' }}" 
                alt="{{ section.settings.logo.alt }}"
            >
        </a>
        <div class="header-custom__links">
            <header-actions>
                {% if shop.customer_accounts_enabled %}
                    {% render 'account-popover' %}
                    {% render 'account-drawer' %}
                {% endif %}
            
                {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
                    {% render 'cart-drawer' %}
                {% else %}
                    <a
                        href="{{ routes.cart_url }}"
                        class="header-actions__action action__cart"
                        aria-label="{{ 'accessibility.cart' | t }} {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}"
                    >
                        {% render 'cart-icon-component' %}
                    </a>
                {% endif %}
            </header-actions>
        </div>
    </div>

    {%- render 'mobile-menu' -%}
</header>

<script>
    const headerMenuMobile = document.querySelector(".header-menu__mobile")
    const headerHumburger = document.querySelector(".header__humburger");

    headerHumburger.addEventListener("click", ()=>{
        headerMenuMobile.classList.toggle("is-show");

        if(headerMenuMobile.classList.contains("is-show")){
            document.body.style.overflow = 'hidden'
        } else {
            document.body.style.overflow = ''
        }
    })
</script>

