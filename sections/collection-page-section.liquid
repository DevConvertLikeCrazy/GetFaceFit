
{{ 'section-products.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}


{% style %}

    .{{ section.id }}{
        padding-top: {{ section.settings.pt }}px;
        padding-bottom: {{ section.settings.pb }}px;
    }

    /* .{{ section.id }} .section-products__rating{
        width: {{ section.settings.rating_width }}px;
        height: {{ section.settings.rating_height }}px;
        object-fit: contain;
    } */

    .{{ section.id }} .section-products__item{
        max-width: calc(100% / {{ section.settings.products_to_show }} - 12px)
    }

    {%- if section.settings.products_to_show == '3' -%}
        .{{ section.id }} .section-products__item{
            max-width: calc(100% / {{ section.settings.products_to_show }} - 16px)
        }
    {%- endif -%}

    {%- if section.settings.products_to_show == '4' -%}
        .{{ section.id }} .section-products__item{
            max-width: calc(100% / {{ section.settings.products_to_show }} - 18px)
        }
    {%- endif -%}


    @media (min-width: 1200px) {
 
    .{{ section.id }} .section-products__item{
        max-width: calc(100% / {{ section.settings.products_to_show }} - 21px)
    }

    {%- if section.settings.products_to_show == '3' -%}
        .{{ section.id }} .section-products__item{
            max-width: calc(100% / {{ section.settings.products_to_show }} - 28px)
        }
    {%- endif -%}

    {%- if section.settings.products_to_show == '4' -%}
        .{{ section.id }} .section-products__item{
            max-width: calc(100% / {{ section.settings.products_to_show }} - 32px)
        }
    {%- endif -%}

    }

    .{{ section.id }} .section-products__title{
        font-size: {{ section.settings.title_fs }}px;
        color: {{ section.settings.title_cl }};
    }

    .{{ section.id }} .section-products__prodtitle{
        font-size: {{ section.settings.prod_title_fs }}px;
        color: {{ section.settings.prod_title_cl }};  
    }

    .{{ section.id }} .section-products__price{
        font-size: {{ section.settings.prod_price_fs }}px;
        color: {{ section.settings.prod_price_cl }}; 
    }

    .{{ section.id }} .section-products__price .product__compare{
        font-size: {{ section.settings.prod_price_fs }}px;
        color: {{ section.settings.prod_price_cl }}; 
    }

    .{{ section.id }} .section-products__description{
        font-size: {{ section.settings.prod_text_fs }}px;
        color: {{ section.settings.prod_text_cl }}; 
    }

    .{{ section.id }} .section-products__shopnow{
        background: {{ section.settings.prod_btn_bg }};
        color: {{ section.settings.prod_btn_cl }};
        font-size: {{ section.settings.prod_btn_fs }}px;
    }

    @media(max-width: 990px){

        .{{ section.id }}{
            padding-top: {{ section.settings.pt_mob }}px;
            padding-bottom: {{ section.settings.pb_mob }}px;
        }

        .{{ section.id }} .section-products__title{
            font-size: {{ section.settings.title_fs_mob }}px;
        }

        .{{ section.id }} .section-products__prodtitle{
            font-size: {{ section.settings.prod_title_fs_mob }}px;
        }

        .{{ section.id }} .section-products__price{
            font-size: {{ section.settings.prod_price_fs_mob }}px;
        }

        .{{ section.id }} .section-products__price .product__compare{
            font-size: {{ section.settings.prod_price_fs_mob }}px;
        }

        .{{ section.id }} .section-products__description{
            font-size: {{ section.settings.prod_text_fs_mob }}px;
        }

        .{{ section.id }} .section-products__shopnow{
            font-size: {{ section.settings.prod_btn_fs_mob }}px;
        }
    }
{% endstyle %}


<section class="section-products collection container {{ section.id }}">
    <div class="section-products__wrapper">
        <div class="section-products__title">{{ section.settings.title }}</div>

        {%- if collection.products != 0 or collection.products != blank  -%}

            {% paginate collection.products by section.settings.products_to_show_pag %}
                <div class="section-products__products">
                    {%- for product in collection.products -%}
                        {%- render 'product-card-new', product: product -%}
                    {%- endfor -%}
                </div>
                {% if paginate.pages > 1 %}
                    <nav class="pagination" role="navigation">
                    {% if paginate.previous %}
                        <a href="{{ paginate.previous.url }}" class="pagination__prev">←</a>
                    {% endif %}
                
                    {% for part in paginate.parts %}
                        {% if part.is_link %}
                        <a href="{{ part.url }}" class="pagination__number">{{ part.title }}</a>
                        {% else %}
                        <span class="pagination__number pagination__current">{{ part.title }}</span>
                        {% endif %}
                    {% endfor %}
                
                    {% if paginate.next %}
                        <a href="{{ paginate.next.url }}" class="pagination__next">→</a>
                    {% endif %}
                    </nav>
                {% endif %}
            {% endpaginate %}
        {%- else -%}
            <div class="section-products__products"></div>
                {%- for product in section.settings.collection.products -%}
                    {%- render 'product-card-new', product: product -%}
                {%- endfor -%}
            </div>
        {%- endif -%}
    </div>
</section>

